<UserControl x:Class="PlayArchive.Views.AddGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="480">

    <StackPanel>
        <!-- Modal Title -->
        <Grid Margin="0,0,0,20">
            <TextBlock Text="ADD NEW GAME TO TRACK" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <Button Command="{Binding CancelCommand}" Style="{StaticResource OutlineButton}" Width="32" Height="32" Padding="0" HorizontalAlignment="Right">
                <TextBlock Text="✕" FontSize="14" />
            </Button>
        </Grid>

        <!-- Auto-Detect Running Process Combo Box -->
        <Border Background="{StaticResource PanelDarkBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="⚡ AUTO-DETECT RUNNING PROCESS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryCyanBrush}" />
                    <Button Command="{Binding RefreshProcessesCommand}" Style="{StaticResource OutlineButton}" Height="24" Padding="6,0" HorizontalAlignment="Right">
                        <TextBlock Text="Refresh List" FontSize="10" />
                    </Button>
                </Grid>

                <ComboBox ItemsSource="{Binding RunningProcesses}" 
                          SelectedItem="{Binding SelectedProcess}"
                          Margin="0,4,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮 " Foreground="{StaticResource PrimaryCyanBrush}" />
                                <TextBlock Text="{Binding MainWindowTitle}" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                <TextBlock Text="{Binding ExecutableName, StringFormat=' ({0})'}" Foreground="#94A3B8" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Select any active process with an open window to auto-fill game details!" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Title Input -->
        <TextBlock Text="Game Title *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,0,0,14" />

        <!-- Executable Name Input -->
        <TextBlock Text="Executable File Name * (e.g. Cyberpunk2077.exe or notepad.exe)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
        <TextBox Text="{Binding ExecutableName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,0,0,14" />

        <!-- Category Input -->
        <TextBlock Text="Category / Genre" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
        <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Margin="0,0,0,14" />

        <!-- User Notes -->
        <TextBlock Text="Initial Notes" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20" />

        <!-- Action Buttons -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{Binding CancelCommand}" Style="{StaticResource OutlineButton}" Content="Cancel" Margin="0,0,6,0" />
            <Button Grid.Column="1" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Content="Save Game" Margin="6,0,0,0" />
        </Grid>
    </StackPanel>
</UserControl>
