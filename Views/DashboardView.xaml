<UserControl x:Class="PlayArchive.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:PlayArchive.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:LogTypeToBrushConverter x:Key="LogBrushConverter" />
        <converters:LogTypeToBadgeConverter x:Key="LogBadgeConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource BgDarkBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30">

            <!-- Top Header & Actions -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="DASHBOARD OVERVIEW" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryCyanBrush}" />
                    <TextBlock Text="Gaming Session Analytics" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,8,0" />
                            <TextBlock Text="Refresh Stats" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Active Now Playing Banner (Visible when game is running) -->
            <Border Style="{StaticResource GamingCard}" 
                    Background="#1F00F0FF" 
                    BorderBrush="{StaticResource PrimaryCyanBrush}" 
                    Margin="0,0,0,24"
                    Visibility="{Binding IsNowPlaying, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="16" Height="16" Fill="{StaticResource PrimaryCyanBrush}" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="CURRENTLY PLAYING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryCyanBrush}" />
                        <TextBlock Text="{Binding ActiveGameTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="{StaticResource PrimaryCyanBrush}" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="LIVE SESSION RECORDING" FontSize="11" FontWeight="Bold" Foreground="#0B0E14" />
                    </Border>
                </Grid>
            </Border>

            <!-- Stat Cards Grid -->
            <UniformGrid Columns="4" Margin="0,0,0,24">

                <!-- Stat 1: Total Games -->
                <Border Style="{StaticResource GamingCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TRACKED GAMES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalGamesCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" />
                        <TextBlock Text="Library collection" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Stat 2: Total Hours -->
                <Border Style="{StaticResource GamingCard}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL PLAYTIME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalPlayTimeFormatted}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryCyanBrush}" Margin="0,8,0,0" />
                        <TextBlock Text="Lifetime recorded" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Stat 3: Total Sessions -->
                <Border Style="{StaticResource GamingCard}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="LOGGED SESSIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalSessionsCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PurpleAccentBrush}" Margin="0,8,0,0" />
                        <TextBlock Text="Recent activity entries" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Stat 4: Top Game -->
                <Border Style="{StaticResource GamingCard}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="MOST PLAYED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding MostPlayedGameTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,14,0,0" />
                        <TextBlock Text="Top title in archive" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Main Content Area: Recent Games & Real-Time Event Feed -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Featured Games Quick List -->
                <Border Style="{StaticResource GamingCard}" Grid.Column="0" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="FEATURED GAMES IN ARCHIVE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <ItemsControl ItemsSource="{Binding FeaturedGames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelDarkBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Game Icon Placeholder -->
                                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="{StaticResource CardDarkBrush}" Margin="0,0,14,0">
                                                <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Border Background="#2A3447" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding ExecutableName}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding FormattedTotalPlayTime}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryCyanBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Text="Total Playtime" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Right Column: Real-Time Process Tracker Activity Feed -->
                <Border Style="{StaticResource GamingCard}" Grid.Column="1" Margin="12,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="PROCESS ENGINE LOGS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border Background="#10B981" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="LIVE FEED" FontSize="10" FontWeight="Bold" Foreground="#0B0E14" />
                            </Border>
                        </Grid>

                        <ScrollViewer Height="320" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DataContext.RecentLogs, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" 
                                                        Background="{Binding Type, Converter={StaticResource LogBrushConverter}}" 
                                                        CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Type, Converter={StaticResource LogBadgeConverter}}" FontSize="9" FontWeight="Bold" Foreground="#0B0E14" />
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <Grid>
                                                        <TextBlock Text="{Binding GameTitle}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding FormattedTimestamp}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
