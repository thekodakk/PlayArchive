<UserControl x:Class="PlayArchive.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:PlayArchive.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
    </UserControl.Resources>

    <Grid Background="{StaticResource BgDarkBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30">

                <!-- Header Section -->
                <Grid Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="SESSION HISTORY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryCyanBrush}" />
                        <TextBlock Text="Recorded Gaming Logs" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBox Width="260" 
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource DarkTextBox}" 
                                 Margin="0,0,12,0" />

                        <Button Command="{Binding LoadSessionsCommand}" Style="{StaticResource OutlineButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Margin="0,0,8,0" />
                                <TextBlock Text="Refresh Logs" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Sessions Summary Banner -->
                <Border Style="{StaticResource GamingCard}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TOTAL SESSIONS RECORDED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalSessionsCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="TOTAL TIME IN SESSIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding TotalSessionHoursText}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryCyanBrush}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sessions List -->
                <Border Style="{StaticResource GamingCard}">
                    <StackPanel>
                        <TextBlock Text="RECENT SESSIONS LOG" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <ItemsControl ItemsSource="{Binding FilteredSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelDarkBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Icon / Status -->
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="{StaticResource CardDarkBrush}" Margin="0,0,14,0">
                                                <TextBlock Text="⏱️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Middle Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding GameItem.Title, FallbackValue='Unknown Game', TargetNullValue='Unknown Game'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <Border Background="#2A3447" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding GameItem.Category, FallbackValue='General', TargetNullValue='General'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="Started: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding StartTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0" />

                                                    <TextBlock Text="Ended: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding EndTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}', FallbackValue='In Progress', TargetNullValue='In Progress'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" Visibility="{Binding Notes, Converter={StaticResource StringToVis}}" />
                                            </StackPanel>

                                            <!-- Right Duration Badge -->
                                            <Border Grid.Column="2" Background="{StaticResource CardDarkBrush}" BorderBrush="{StaticResource PrimaryCyanBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" VerticalAlignment="Center">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding FormattedDuration}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryCyanBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Duration" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
